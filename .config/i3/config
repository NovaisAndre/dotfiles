set $mod Mod4
floating_modifier $mod

font pango:System San Francisco Display 12 

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet

set $refresh_i3status killall -SIGUSR1 i3status

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +2% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -2% && $refresh_i3status
bindsym Shift+XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +20% && $refresh_i3status
bindsym Shift+XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -20% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym $mod+XF86AudioRaiseVolume exec ~/dotfiles/.scripts/raise_volume.sh
bindsym $mod+XF86AudioLowerVolume exec ~/dotfiles/.scripts/lower_volume.sh
bindsym $mod+Shift+q kill
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $ws11 "11"
set $ws12 "12"
set $ws13 "13"
set $ws14 "14"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+minus workspace number $ws11
bindsym $mod+percent workspace number $ws12
bindsym $mod+F1 workspace number $ws13
bindsym $mod+F2 workspace number $ws14
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod+Shift+minus move container to workspace number $ws11
bindsym $mod+Shift+percent move container to workspace number $ws12
bindsym $mod+Shift+F1 move container to workspace number $ws13
bindsym $mod+Shift+F2 move container to workspace number $ws14

mode "resize" {
        bindsym h resize shrink width 6 px or 6 ppt
        bindsym j resize grow height 6 px or 6 ppt
        bindsym k resize shrink height 6 px or 6 ppt
        bindsym l resize grow width 6 px or 6 ppt
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

set $bg-color 	         #1a1b26
set $inactive-bg-color   #2f343f
set $text-color          #f3f4f5
set $inactive-text-color #676E7D
set $urgent-bg-color     #E53935

# window colors
#                       border              background         text                 indicator
client.focused          $bg-color           $bg-color          $text-color          #00ff00
client.unfocused        $inactive-bg-color $inactive-bg-color $inactive-text-color #00ff00
client.focused_inactive $inactive-bg-color $inactive-bg-color $inactive-text-color #00ff00
client.urgent           $urgent-bg-color    $urgent-bg-color   $text-color          #00ff00

hide_edge_borders both
for_window [class="^.*"] border pixel 2
                          # class                 border  backgr. text    indicator child_border
for_window [class="^.*"] client.focused          #77dd77 #285577 #ffffff #2e9ef4   #285577

#gaps inner 10
#gaps outer 10
# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
        status_command i3blocks -c ~/.config/i3/i3blocks.conf
        colors {
		background $bg-color
        #separator #757575
		#                  border             background         text
		focused_workspace  $bg-color          $bg-color          $text-color
		inactive_workspace $inactive-bg-color $inactive-bg-color $inactive-text-color
		urgent_workspace   $urgent-bg-color   $bg-color   $text-color
	}
}

bindsym $mod+r mode "resize"
bindsym $mod+Return exec kitty
bindsym $mod+Ctrl+t exec kitty
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+shift+x exec i3lock -f -c 1A1B26 -i ~/.wallpapers/.not-using/tokyo.png && systemctl suspend
bindsym $mod+shift+w exec sh ~/dotfiles/.scripts/set_wallpaper.sh 
bindsym $mod+x exec i3lock -f -c 1A1B26 -i ~/.wallpapers/.not-using/tokyo.png
bindsym $mod+Shift+p move workspace to output down
bindsym $mod+Shift+o move workspace to output left 
bindsym $mod+d exec "rofi -modi drun,run -show drun"
bindsym $mod+Shift+c reload restart i3 inplace
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
bindsym Print exec sh ~/dotfiles/.scripts/screenshot.sh 
bindsym $mod+n exec dunstctl close-all
bindsym $Shift+Print exec gnome-screenshot -i
bindsym $mod+p exec  sh ~/.screenlayout/stacked.sh
bindsym $mod+o exec  sh ~/.screenlayout/monitor.sh
bindsym $mod+i exec  sh ~/.screenlayout/notebook.sh
bindsym $mod+y exec  sh ~/.screenlayout/low-res.sh
bindsym $mod+m exec  sh ~/coding-projects/Python/Productive-Notifications/macros/getCursorPosition.sh
bindsym $mod+shift+m exec  python3 ~/work/Productive-Notifications/macros/fightcade_macro.py
bindsym $mod+shift+n exec  python3 ~/dotfiles/.scripts/showtime-i3.py
bindsym $mod+shift+t exec  python3 ~/dotfiles/.scripts/close_all.py
bindsym $mod+g exec kitty ./coding-projects/Python/Productive-Notifications/macros/getCursorPosition.sh pause

exec_always ~/dotfiles/.scripts/cycle_wallpapers.sh
exec_always dunst
exec_always xrandr --output eDP-1 --primary --mode 1366x768 --pos 277x1080 --rotate normal --output HDMI-1 --mode 1920x1080 --pos 0x0 --rotate normal
exec_always picom 
exec_always xmodmap ~/.Xmodmap

exec --no-startup-id redshift -c ~/.config/redshift.conf
exec --no-startup-id xinput --set-prop 11 'Coordinate Transformation Matrix' 0.5 0 0 0 0.5 0 0 0 1
exec --no-startup-id xbindkeys
exec telegram-desktop
exec discord

assign [class="Spotify"] $ws9
assign [class="discord"] $ws11
assign [class="TelegramDesktop"] $ws12
