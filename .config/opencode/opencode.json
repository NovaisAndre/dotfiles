{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "moonshotai": {
      "options": {
        "baseURL": "https://litellm.arnoldosilva.dev.br/v1"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  },
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ]
}
